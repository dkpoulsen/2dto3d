{
  "id": "builtin-cinema-anaglyph",
  "name": "Cinema (Anaglyph)",
  "description": "High-quality anaglyph preset for red-cyan 3D glasses. Uses Dubois color method for best color reproduction. Optimized for viewing on large screens with 3D glasses.",
  "category": "cinema",
  "tags": ["cinema", "anaglyph", "high-quality", "glasses"],
  "settings": {
    "depth_estimation": {
      "model": "dpt_large",
      "output_width": 384,
      "output_height": 384,
      "min_depth": 0.0,
      "max_depth": 1.0,
      "temporal_consistency": true,
      "temporal_smoothing_factor": 0.5
    },
    "stereo_generation": {
      "format": "anaglyph",
      "baseline": 0.05,
      "focal_length": 1.0,
      "convergence": 0.5,
      "anaglyph_type": "red_cyan",
      "anaglyph_color_method": "dubois",
      "sbs_layout": "horizontal",
      "sbs_swap_eyes": false,
      "sbs_half_width": false
    },
    "video_output": {
      "format": "mp4",
      "codec": "libx264",
      "preset": "slow",
      "crf": 18,
      "pixel_format": "yuv420p"
    },
    "processing": {
      "batch_size": 4,
      "num_workers": 4,
      "use_gpu": true,
      "gpu_device": 0,
      "mixed_precision": true,
      "max_memory_percent": 80
    },
    "quality": {
      "preset": "quality",
      "post_processing": true,
      "calculate_metrics": false
    }
  },
  "created_at": "2024-01-01T00:00:00",
  "updated_at": "2024-01-01T00:00:00",
  "is_builtin": true,
  "version": "1.0.0",
