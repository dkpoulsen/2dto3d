{
  "id": "builtin-vr-over-under",
  "name": "VR (Over-Under)",
  "description": "Optimized for VR headset viewing with over-under format. Uses increased baseline for stronger 3D effect and higher depth resolution. Compatible with most VR players.",
  "category": "vr",
  "tags": ["vr", "over-under", "headset", "immersive"],
  "settings": {
    "depth_estimation": {
      "model": "dpt_hybrid",
      "output_width": 512,
      "output_height": 512,
      "min_depth": 0.0,
      "max_depth": 1.0,
      "temporal_consistency": true,
      "temporal_smoothing_factor": 0.5
    },
    "stereo_generation": {
      "format": "vr",
      "baseline": 0.08,
      "focal_length": 1.0,
      "convergence": 0.5,
      "anaglyph_type": "red_cyan",
      "anaglyph_color_method": "dubois",
      "sbs_layout": "horizontal",
      "sbs_swap_eyes": false,
      "sbs_half_width": false
    },
    "video_output": {
      "format": "mp4",
      "codec": "libx264",
      "preset": "medium",
      "crf": 20,
      "pixel_format": "yuv420p"
    },
    "processing": {
      "batch_size": 4,
      "num_workers": 4,
      "use_gpu": true,
      "gpu_device": 0,
      "mixed_precision": true,
      "max_memory_percent": 80
    },
    "quality": {
      "preset": "balanced",
      "post_processing": true,
      "calculate_metrics": false
    }
  },
  "created_at": "2024-01-01T00:00:00",
  "updated_at": "2024-01-01T00:00:00",
  "is_builtin": true,
  "version": "1.0.0",
  "author": "2Dto3D"
}
