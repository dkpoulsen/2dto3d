{
  "id": "builtin-vr-sbs",
  "name": "VR (Side-by-Side)",
  "description": "Side-by-side format optimized for VR viewing. Half-width encoding for compatibility with mobile VR. Good balance of quality and file size.",
  "category": "vr",
  "tags": ["vr", "side-by-side", "mobile-vr", "oculus", "cardboard"],
  "settings": {
    "depth_estimation": {
      "model": "midas_hybrid",
      "output_width": 384,
      "output_height": 384,
      "min_depth": 0.0,
      "max_depth": 1.0,
      "temporal_consistency": true,
      "temporal_smoothing_factor": 0.5
    },
    "stereo_generation": {
      "format": "side_by_side",
      "baseline": 0.07,
      "focal_length": 1.0,
      "convergence": 0.5,
      "anaglyph_type": "red_cyan",
      "anaglyph_color_method": "dubois",
      "sbs_layout": "horizontal",
      "sbs_swap_eyes": false,
      "sbs_half_width": true
    },
    "video_output": {
      "format": "mp4",
      "codec": "libx264",
      "preset": "medium",
      "crf": 22,
      "pixel_format": "yuv420p"
    },
    "processing": {
      "batch_size": 4,
      "num_workers": 4,
      "use_gpu": true,
      "gpu_device": 0,
      "mixed_precision": true,
      "max_memory_percent": 80
    },
    "quality": {
      "preset": "balanced",
      "post_processing": true,
      "calculate_metrics": false
    }
  },
  "created_at": "2024-01-01T00:00:00",
  "updated_at": "2024-01-01T00:00:00",
  "is_builtin": true,
  "version": "1.0.0",
  "author": "2Dto3D"
}
